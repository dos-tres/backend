APP_ENV=local
# JSON array of exact frontend origins (scheme + host + port).
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Set local-only passwords and matching URLs before starting Docker/DB checks.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
# Format: postgresql+psycopg://dos_tres:<URL-encoded-password>@127.0.0.1:5432/dos_tres
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_PORT=55432
TEST_DATABASE_URL=
# Format: postgresql+psycopg://dos_tres_test:<URL-encoded-password>@127.0.0.1:55432/dos_tres_test
# --- 데이터 파이프라인 (pipeline/) — 서버 전용 비밀 설정 ---
# 온통청년 Open API 키 (청년정책 / 청년공간·센터는 따로 발급)
YOUTH_POLICY_API_KEY=
YOUTH_CENTER_API_KEY=
# LLM (OpenAI): 파이프라인 분류와 대화(/api/chat)가 같이 쓴다
# 비우면 /api/chat 은 503 AI_UNAVAILABLE (위기 안내는 키 없이도 동작). OPENAI_BASE_URL 을 비우면 https://api.openai.com/v1
# 예전 GMS_KEY 는 종료됐다. 남아 있으면 지운다 (OPENAI_API_KEY 가 있으면 그쪽을 먼저 쓴다)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 비우면 gpt-4.1-mini
LLM_MODEL=
# 챗봇 신청: 테스트 구글폼 목록 JSON 경로 (*.local.json 은 Git 제외, docs/APPLY.md 11장)
APPLY_FORMS_PATH=
